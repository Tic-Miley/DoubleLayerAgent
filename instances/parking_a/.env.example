# ═══════════════════════════════════════════════════════════════
# ParkingLotAgent A — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Each parking instance (A / B / C) runs the same code with a
# different .env — adjust PARKING_NAME, PORT, DATABASE_PATH,
# and capacity values for each instance.

# ── LLM (DeepSeek) ──────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Thinking mode: "enabled" (higher reasoning) or "disabled" (faster response)
# Recommended "disabled" for L2 agents to keep latency low
THINKING_MODE=disabled

# ── Server ──────────────────────────────────────────────────
PORT=8011

# ── Parking lot identity ────────────────────────────────────
PARKING_NAME=购物中心停车场

# ── Parking lot capacity ────────────────────────────────────
TOTAL_SPOTS=800
FLOORS=4
# Comma-separated spots per floor, or a single integer shorthand
# (e.g. "200" with FLOORS=4 → [200,200,200,200])
SPOTS_PER_FLOOR=200,200,200,200

# ── Database ────────────────────────────────────────────────
DATABASE_PATH=data/parking_a.db

# ── NEV distribution weights (ICE,BEV,PHEV,HEV) ─────────────
# Must sum to ~100; data_generator.py normalizes by dividing by sum
NEV_WEIGHTS=55,25,12,8

# ── Agent behaviour ─────────────────────────────────────────
MAX_ITERATIONS=8
