# ═══════════════════════════════════════════════════════════════
# ParkingLotAgent B — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM (DeepSeek) ──────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
THINKING_MODE=disabled

# ── Server ──────────────────────────────────────────────────
PORT=8012

# ── Parking lot identity ────────────────────────────────────
PARKING_NAME=科技园停车场

# ── Parking lot capacity ────────────────────────────────────
TOTAL_SPOTS=500
FLOORS=3
SPOTS_PER_FLOOR=167,167,166

# ── Database ────────────────────────────────────────────────
DATABASE_PATH=data/parking_b.db

# ── NEV distribution weights (ICE,BEV,PHEV,HEV) ─────────────
NEV_WEIGHTS=50,30,12,8

# ── Agent behaviour ─────────────────────────────────────────
MAX_ITERATIONS=8
