# ═══════════════════════════════════════════════════════════════
# ParkingLotAgent C — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM (DeepSeek) ──────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
THINKING_MODE=disabled

# ── Server ──────────────────────────────────────────────────
PORT=8013

# ── Parking lot identity ────────────────────────────────────
PARKING_NAME=社区停车场

# ── Parking lot capacity ────────────────────────────────────
TOTAL_SPOTS=1200
FLOORS=5
SPOTS_PER_FLOOR=240,240,240,240,240

# ── Database ────────────────────────────────────────────────
DATABASE_PATH=data/parking_c.db

# ── NEV distribution weights (ICE,BEV,PHEV,HEV) ─────────────
NEV_WEIGHTS=60,20,12,8

# ── Agent behaviour ─────────────────────────────────────────
MAX_ITERATIONS=8
