# ═══════════════════════════════════════════════════════════════
# L1 Orchestrator Agent — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM (DeepSeek) ──────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Thinking mode: "enabled" (higher reasoning) or "disabled" (faster response)
THINKING_MODE=enabled

# ── Server ──────────────────────────────────────────────────
L1_PORT=8001

# ── User default location (Beijing, decimal degrees) ────────
USER_DEFAULT_LAT=39.9150
USER_DEFAULT_LNG=116.4040

# ── Agent behaviour ─────────────────────────────────────────
MAX_ITERATIONS=8
L2_TIMEOUT_SECONDS=20.0

# ── Config files (relative to l1_agent/ directory) ──────────
THINGS_CONFIG=../config/things.yaml
TOOLS_CONFIG=../config/tools.yaml
