# ═══════════════════════════════════════════════════════════════
# SimpleThings Service — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Server ──────────────────────────────────────────────────
PORT=8010

# ── Simulated capacities ────────────────────────────────────
# Cafeteria: random headcount in [0, CAFETERIA_CAPACITY]
CAFETERIA_CAPACITY=500
# Hospital:   random headcount in [0, HOSPITAL_CAPACITY]
HOSPITAL_CAPACITY=300
